[node name="HandlingChart" type="Node" parent="."]
script = ExtResource("chart")
track_in_editor = true

[node name="Handling" type="Node" parent="HandlingChart"]
script = ExtResource("compound")
initial_state = NodePath("Ready")

[node name="Ready" type="Node" parent="HandlingChart/Handling"]
script = ExtResource("atomic")

[node name="ToReloading" type="Node" parent="HandlingChart/Handling/Ready"]
script = ExtResource("transition")
to = NodePath("../../Reloading")
event = &"reload"

[node name="Reloading" type="Node" parent="HandlingChart/Handling"]
script = ExtResource("atomic")

[node name="ToReady" type="Node" parent="HandlingChart/Handling/Reloading"]
script = ExtResource("transition")
to = NodePath("../../Ready")
event = &"ready"

[node name="AimChart" type="Node" parent="."]
script = ExtResource("chart")
track_in_editor = true

[node name="Aim" type="Node" parent="AimChart"]
script = ExtResource("compound")
initial_state = NodePath("Hip")

[node name="Hip" type="Node" parent="AimChart/Aim"]
script = ExtResource("atomic")

[node name="ToADS" type="Node" parent="AimChart/Aim/Hip"]
script = ExtResource("transition")
to = NodePath("../../ADS")
event = &"aim"

[node name="ADS" type="Node" parent="AimChart/Aim"]
script = ExtResource("atomic")

[node name="ToHip" type="Node" parent="AimChart/Aim/ADS"]
script = ExtResource("transition")
to = NodePath("../../Hip")
event = &"hip"

[connection signal="state_entered" from="HandlingChart/Handling/Reloading" to="." method="_on_reload_entered"]

[connection signal="timeout" from="ReloadTimer" to="." method="_on_reload_timeout"]
