[gd_scene format=3]

[ext_resource type="Script" path="res://interaction/fan_kit.gd" id="1_fan"]
[ext_resource type="Script" path="res://addons/godot_state_charts/state_chart.gd" id="2_chart"]
[ext_resource type="Script" path="res://addons/godot_state_charts/compound_state.gd" id="3_compound"]
[ext_resource type="Script" path="res://addons/godot_state_charts/atomic_state.gd" id="4_atomic"]
[ext_resource type="Script" path="res://addons/godot_state_charts/transition.gd" id="5_transition"]

[node name="FanKit" type="Node3D"]
script = ExtResource("1_fan")

[node name="StateChart" type="Node" parent="."]
script = ExtResource("2_chart")
track_in_editor = true

[node name="Motion" type="Node" parent="StateChart"]
script = ExtResource("3_compound")
initial_state = NodePath("Running")

[node name="Reset" type="Node" parent="StateChart/Motion"]
script = ExtResource("5_transition")
to = NodePath("../Running")
event = &"reset"

[node name="Running" type="Node" parent="StateChart/Motion"]
script = ExtResource("4_atomic")

[node name="Stop" type="Node" parent="StateChart/Motion/Running"]
script = ExtResource("5_transition")
to = NodePath("../../SpinningDown")
event = &"stop"

[node name="SpinningDown" type="Node" parent="StateChart/Motion"]
script = ExtResource("4_atomic")

[node name="Settled" type="Node" parent="StateChart/Motion/SpinningDown"]
script = ExtResource("5_transition")
to = NodePath("../../Stopped")
event = &"settled"

[node name="Stopped" type="Node" parent="StateChart/Motion"]
script = ExtResource("4_atomic")

[connection signal="state_entered" from="StateChart/Motion/Running" to="." method="_on_state_entered" binds=["Running"]]

[connection signal="state_entered" from="StateChart/Motion/SpinningDown" to="." method="_on_state_entered" binds=["SpinningDown"]]

[connection signal="state_entered" from="StateChart/Motion/Stopped" to="." method="_on_state_entered" binds=["Stopped"]]

[connection signal="state_physics_processing" from="StateChart/Motion/Running" to="." method="_on_running_physics"]

[connection signal="state_physics_processing" from="StateChart/Motion/SpinningDown" to="." method="_on_spinning_down_physics"]
